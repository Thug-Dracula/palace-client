# Rust build artifacts
/target/
**/*.rs.bk
**/*.profraw

# Tauri generated schema (regenerated on every build)
/src-tauri/gen/schemas

# Frontend (SvelteKit + Vite + Bun)
/node_modules/
/build/
/.svelte-kit/
/vite.config.js.timestamp-*
/vite.config.ts.timestamp-*

# Local scratch
/scratch/
*.tmp

# Personal substitutions for the published copy — must never be pushed
tools/public-scrub.map

# Editor
.vscode/
.idea/
*.swp

# Python bytecode from the prop-codec oracles
__pycache__/
*.pyc

# Local, non-committed project notes
NOTES.local.md

# --- PalaceChat prop bag and any local prop data -------------------------
# The user's prop bag is PERSONAL DATA that lives outside this repo
# (~/.local/share/PalaceChat/PropBag.bundle). It is read at runtime and
# must NEVER be committed, bundled into a build, or attached to a release.
# These patterns are a guard rail: do not remove them.
PropBag.bundle/
PalaceChat.pids
PalaceChat.props
PalaceChat.favs
Trash.favs
*.pids
*.favs
*.props
