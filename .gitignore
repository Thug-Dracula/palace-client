# Rust build artifacts
/target/
**/*.rs.bk
**/*.profraw

# Tauri generated schema (regenerated on every build)
/src-tauri/gen/schemas

# Frontend (SvelteKit + Vite + Bun)
/node_modules/
/build/
/.svelte-kit/
/vite.config.js.timestamp-*
/vite.config.ts.timestamp-*

# Local scratch
/scratch/
*.tmp

# Editor
.vscode/
.idea/
*.swp

# Python bytecode from the prop-codec oracles
__pycache__/
*.pyc
