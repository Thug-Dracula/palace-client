{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "palace-client",
  "version": "0.2.0",
  "identifier": "org.palace.client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Palace",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' palace: data: blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost palace: http://palace.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/soundfonts/GeneralUser-GS.sf2",
      "resources/soundfonts/GeneralUser-GS-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
